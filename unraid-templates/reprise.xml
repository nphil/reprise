<?xml version="1.0"?>
<Container version="2">
  <Name>Reprise</Name>
  <Repository>ghcr.io/nphil/reprise@sha256:91571a47ff1108e4526ec3d2c449877c0aef69815f8d345d39ee3089b9939bd1</Repository>
  <Registry>https://github.com/nphil/reprise/pkgs/container/reprise</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/nphil/reprise/issues</Support>
  <Project>https://github.com/nphil/reprise</Project>
  <Overview>Self-hosted media analysis and review. In development: review results and keep production publishing disabled during evaluation. The pinned image is a specific published build; select a newer published immutable image to update. Media is read-only; Plex database access is not mounted by default.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/nphil/reprise/main/media_preview_generator/web/static/icon-512.png</Icon>
  <Config Name="Web UI" Target="8080" Default="8080" Mode="tcp" Description="Web interface" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="App data" Target="/config" Default="/mnt/user/appdata/reprise" Mode="rw" Description="Persistent configuration and results" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/reprise</Config>
  <Config Name="Media" Target="/media" Default="" Mode="ro" Description="Read-only media library" Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Unraid user ID" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Unraid group ID" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
</Container>
